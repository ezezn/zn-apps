{
  "name": "pwa-app2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "predev": "npm run icons",
    "build": "vite build",
    "prebuild": "npm run icons",
    "preview": "vite preview",
