    "@zn-apps/ui-about": "*",
    "@zn-apps/ui-core": "*",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
