{
  "name": "zound-box",
  "private": true,
  "version": "0.1.1",
  "description": "Combina sonidos ambientales y sonidos de seseo para relajarse.",
  "author": "ZN Apps",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
